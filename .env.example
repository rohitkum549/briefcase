# Local development config. Copy this file to .env (gitignored) and fill it in.
#
#   cp .env.example .env
#
# Without a .env, the app falls back to the obviously-fake placeholders in
# src/config/env.ts — you will see "Your Name" and a dead GitHub link. That is
# intentional: it makes missing config visible instead of silently plausible.
#
# PRODUCTION DOES NOT USE THIS FILE. Nothing reads .env.example, and .env is
# never committed. The deployed site gets its values from
#   GitHub -> Settings -> Secrets and variables -> Actions -> Variables
# passed through the `env:` block on the build step in .github/workflows.
# That is the single source of truth: to change what the live site shows, edit
# the repository variable, not this file and not env.ts.
#
# The deploy workflow runs with STRICT_ENV=1, so vite.config.ts fails the build
# if any variable below (except the optional endpoint) is missing there.

VITE_SITE_NAME="Your Name"
VITE_CONTACT_EMAIL="you@example.com"
VITE_CONTACT_PHONE="+00 00000 00000"
VITE_GITHUB_URL="https://github.com/your-username"
VITE_LINKEDIN_URL="https://www.linkedin.com/in/your-handle/"

# Optional: POST endpoint for the contact form. When unset, the form falls
# back to a simulated submission and a mailto: link.
VITE_CONTACT_ENDPOINT=
